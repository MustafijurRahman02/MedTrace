# Test on every push / pull request; deploy to Azure App Service when `main` changes.
# One-time setup (see docs/DEPLOY_GITHUB_AZURE.md, Part 4):
#   Repository > Settings > Secrets and variables > Actions
#     Secret   AZURE_WEBAPP_PUBLISH_PROFILE   (downloaded from the App Service "Overview" page)
#     Variable AZURE_WEBAPP_NAME              (the name of your App Service)
# No database passwords or storage keys belong in GitHub: they live in the App Service settings.
name: Test and deploy MedTrace

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
          cache-dependency-path: backend/requirements.txt
      - run: pip install -r requirements.txt
      - name: Run tests (local SQLite only - never touches Azure)
        working-directory: backend
        run: python -m pytest -q

  deploy:
    needs: test
    if: github.ref == 'refs/heads/main' && github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build deployment package
        run: zip -qr release.zip . -x ".git/*" ".github/*" "backend/tests/*" "backend/.venv/*" "*/__pycache__/*" "docs/*" "*.db" ".env"
      - uses: azure/webapps-deploy@v3
        with:
          app-name: ${{ vars.AZURE_WEBAPP_NAME }}
          publish-profile: ${{ secrets.AZURE_WEBAPP_PUBLISH_PROFILE }}
          package: release.zip

