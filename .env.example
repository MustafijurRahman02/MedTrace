# Copy this file to ".env" (same folder as README.md) and fill in YOUR values. Never commit or share ".env".
# If a value contains  #  ;  spaces or quotes, wrap it in double quotes, e.g.  AZURE_SQL_PASSWORD="My#Pass;word1"

# ---- Azure SQL Database (see docs/AZURE_SETUP.md) --------------------------------------------------------
# Server name: Azure portal > your SQL database > Overview > "Server name"
AZURE_SQL_SERVER=your-server-name.database.windows.net
AZURE_SQL_DATABASE=medtrace-db
AZURE_SQL_USER=medadmin
AZURE_SQL_PASSWORD="your-server-admin-password"

# Optional: driver name if you installed a different one (default is "ODBC Driver 18 for SQL Server")
# AZURE_SQL_DRIVER=ODBC Driver 17 for SQL Server

# Optional alternative: paste the whole ODBC connection string instead of the four settings above
# AZURE_SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:...;Database=...;Uid=...;Pwd=...;Encrypt=yes;"

# ---- App -------------------------------------------------------------------------------------------------
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# 0 = the database stays empty (default). 1 = load synthetic demo data on start-up if there are no users.
MEDTRACE_SEED=0

# Set to 1 when the site is served over HTTPS (e.g. Azure App Service) to send the HSTS header.
MEDTRACE_HTTPS=0

# ---- Azure Blob Storage: where uploaded CSV evidence files are kept (see docs/AZURE_SETUP.md, Part B) -----
# Storage account > Security + networking > Access keys > Connection string. Keep the double quotes.
# Leave this line out (or empty) to save the files in the local folder below instead.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=your-key==;EndpointSuffix=core.windows.net"
# Container name (created automatically, PRIVATE). 3-63 chars: lowercase letters, numbers, hyphens.
AZURE_STORAGE_CONTAINER=medtrace-evidence

# Local fallback folder used only when no connection string is set
MEDTRACE_STORAGE=storage
